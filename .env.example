# Copy to .env locally. Never commit real credentials.
APP_ENV=development
PORT=8000
DATABASE_PATH=data/setu.db
# Generate a permanent secret: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS origin of the Python backend, without a trailing slash.
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Optional template SIDs created by python -m bot.setup_twilio
TWILIO_MENU_EN_SID=
TWILIO_MENU_HI_SID=
